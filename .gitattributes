# Force LF endings for kernel/driver source — CRLF breaks kernel build
* text=auto eol=lf

*.c    text eol=lf
*.h    text eol=lf
*.S    text eol=lf
*.s    text eol=lf
Makefile text eol=lf
*.mk   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
